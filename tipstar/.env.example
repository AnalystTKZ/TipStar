# ---- Supabase PostgreSQL ----
SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@aws-0-eu-west-3.pooler.supabase.com:5432/postgres

# ---- Groq ----
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# ---- OpenRouter fallback ----
# Used automatically when Groq is rate-limited, out of tokens, or unavailable.
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=openrouter/owl-alpha
OPENROUTER_FALLBACK_MODELS=openrouter/owl-alpha,openai/gpt-oss-120b:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
OPENROUTER_SITE_URL=http://localhost:8000
OPENROUTER_APP_NAME=TipStar

# ---- NewsAPI ----
NEWS_API_KEY=your_newsapi_key

# ---- Twitter / X ----
TWITTER_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# ---- Notion ----
NOTION_API_KEY=your_notion_api_key
NOTION_PLAYERS_DB_ID=
NOTION_TEAMS_DB_ID=
NOTION_DRAMA_DB_ID=
NOTION_CONFIG_PAGE_ID=
NOTION_MATCHES_DB_ID=
NOTION_CONTENT_CALENDAR_DB_ID=
NOTION_TOURNAMENTS_DB_ID=

# ---- API-Football (RapidAPI) ----
API_FOOTBALL_KEY=your_rapidapi_key_here
API_FOOTBALL_HOST=api-sports.io
ENABLE_API_FOOTBALL_PLAYER_SYNC=false
# Keep false on the free tier. Enable only if your plan returns current data.
ENABLE_API_FOOTBALL_LIVE_SYNC=false

# ---- Optional FBref player-stat sync ----
# Disabled by default because FBref may reject scheduled/CI traffic with HTTP 403.
ENABLE_FBREF_PLAYER_SYNC=false

# ---- football-data.org ----
FOOTBALL_DATA_KEY=your_football_data_key_here

# ---- Frontend ----
FRONTEND_ORIGIN=http://localhost:5173

# ---- Additional content sources ----
GUARDIAN_API_KEY=your_guardian_open_platform_key_here
YOUTUBE_API_KEY=your_youtube_data_api_key_here
YOUTUBE_INTELLIGENCE_HOURS=4
YOUTUBE_MAX_VIDEOS_PER_RUN=5
YOUTUBE_MAX_VIDEOS_PER_CHANNEL=2
YOUTUBE_MIN_RELEVANCE_SCORE=8
