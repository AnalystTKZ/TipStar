# ---- Supabase PostgreSQL ----
SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@aws-0-eu-west-3.pooler.supabase.com:5432/postgres

# ---- Groq ----
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama3-70b-8192

# ---- NewsAPI ----
NEWS_API_KEY=your_newsapi_key

# ---- Twitter / X ----
TWITTER_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# ---- Notion ----
NOTION_API_KEY=your_notion_api_key
NOTION_PLAYERS_DB_ID=
NOTION_TEAMS_DB_ID=
NOTION_DRAMA_DB_ID=
NOTION_CONFIG_PAGE_ID=
NOTION_MATCHES_DB_ID=
NOTION_CONTENT_CALENDAR_DB_ID=
NOTION_TOURNAMENTS_DB_ID=

# ---- API-Football (RapidAPI) ----
API_FOOTBALL_KEY=your_rapidapi_key_here
API_FOOTBALL_HOST=api-sports.io
ENABLE_API_FOOTBALL_PLAYER_SYNC=false

# ---- Optional FBref player-stat sync ----
# Disabled by default because FBref may reject scheduled/CI traffic with HTTP 403.
ENABLE_FBREF_PLAYER_SYNC=false

# ---- football-data.org ----
FOOTBALL_DATA_KEY=your_football_data_key_here

# ---- Frontend ----
FRONTEND_ORIGIN=http://localhost:5173
